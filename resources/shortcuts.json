{
  "schema": 1,
  "_comment": "Default keyboard shortcuts (v0.3.2 MAJOR-09). User overrides live in %APPDATA%/Vela Docs/shortcuts.json.",
  "bindings": {
    "bold":            "Ctrl+B",
    "italic":          "Ctrl+I",
    "underline":       "Ctrl+U",
    "strikethrough":   "Ctrl+Shift+S",
    "clearFormat":     "Ctrl+\\\\",
    "bulletList":      "Ctrl+Shift+L",
    "orderedList":     "Ctrl+Shift+O",
    "taskList":        "Ctrl+Shift+7",
    "indent":          "Ctrl+]",
    "outdent":         "Ctrl+[",
    "h1":              "Ctrl+1",
    "h2":              "Ctrl+2",
    "h3":              "Ctrl+3",
    "h4":              "Ctrl+4",
    "paragraph":       "Ctrl+0",
    "undo":            "Ctrl+Z",
    "redo":            "Ctrl+Y",
    "redoAlt":         "Ctrl+Shift+Z",
    "new":             "Ctrl+N",
    "open":            "Ctrl+O",
    "save":            "Ctrl+S",
    "saveAs":          "Ctrl+Shift+S",
    "print":           "Ctrl+P",
    "selectAll":       "Ctrl+A",
    "docStart":        "Ctrl+Home",
    "docEnd":          "Ctrl+End",
    "find":            "Ctrl+F",
    "replace":         "Ctrl+H",
    "findNext":        "F3",
    "findPrev":        "Shift+F3",
    "insertLink":      "Ctrl+K",
    "insertImage":     "Ctrl+Alt+I",
    "pageBreak":       "Ctrl+Enter",
    "hardBreak":       "Shift+Enter",
    "focusMode":       "Ctrl+Shift+F11",
    "spellCheck":      "F7",
    "switchToHome":    "Ctrl+Alt+H",
    "switchToInsert":  "Ctrl+Alt+I2",
    "switchToTable":   "Ctrl+Alt+T",
    "commentAdd":      "Ctrl+Alt+M",
    "footnoteAdd":     "Ctrl+Alt+F",
    "endnoteAdd":      "Ctrl+Alt+D"
  }
}
